HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Must match the root .env values; URL-encode special characters in passwords.
DATABASE_URL=postgresql://sku_cook:change-me-local-only@127.0.0.1:5432/sku_cook?schema=public
NODE_ENV=development
# 可选：浏览器的精确同源地址（协议+主机+端口，不含路径或尾部斜杠）。
# APP_ORIGIN=http://localhost:5173
# Seed 必填；仅在本机 .env 或当前进程环境配置，不提交实际值。
BOOTSTRAP_USER_PASSWORD=
# 采购集成：两个配置均不设置时关闭；启用时只在真实后端环境中配置。
# TODO_ORIGIN=https://todo.taila48442.ts.net
# TODO_COOK_INTEGRATION_TOKEN：与 Todo 相同的专用机器凭据，不在样例中填写值。
# TODO_COOK_USER_ID：做菜账号的稳定数字 ID，须与 Todo 绑定值相同，不是邮箱。
