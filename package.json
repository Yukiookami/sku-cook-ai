{
  "name": "sku-cook-ai",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @sku-cook/shared build && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @sku-cook/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @sku-cook/shared build && pnpm -r test",
    "db:generate": "pnpm --filter @sku-cook/api db:generate",
    "db:migrate": "pnpm --filter @sku-cook/api db:migrate",
    "db:seed": "pnpm --filter @sku-cook/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
